# Build products and local test output
.build/
dist/
bin/
obj/
*.dll
*.exe
*.pdb
*.log
tests/artifacts/
tests/*.png
tests/.ocr-smoke-*/
tests/.ocr-layout-*/

# Python caches and machine-specific editor settings
__pycache__/
*.py[cod]
.venv/
venv/
.vs/
.vscode/
*.user
*.suo

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Private inputs and generated comparisons/reports
/inputs/
/archives/
/results/
~$*
*.doc
*.docx
*.pdf
*.csv

